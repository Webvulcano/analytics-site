# Supabase (admin app) — publikus értékek
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Csak scriptekhez (sync-manifest, gc-storage) — SOHA ne Vercelre
SUPABASE_SECRET_KEY=

# Revalidate secret levezetéshez (HMAC, slugonként)
CMS_MASTER_SECRET=

# Google service account JSON egy sorban (GA4 + Search Console olvasás)
GOOGLE_SA_KEY=

# Vercel Cron védelme (/api/keepalive - napi Supabase-ping, hogy a free projekt ne álljon le). Vercelen állítsd be.
CRON_SECRET=

# Dev admin only: local client sites the editor frames (slug=origin, comma-separated). Ignored on Vercel.
CMS_DEV_SITE_URLS=hallasgondozo=http://localhost:3700
